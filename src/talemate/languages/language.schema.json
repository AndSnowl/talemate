{
  "$defs": {
    "AddressRow": {
      "description": "How one kind of relationship addresses a person: the role words\nthat map onto it and the parts it uses (part labels, \"title\", \"pet\nname\"); the `default` row is for anyone unmatched.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "uses": {
          "items": {
            "type": "string"
          },
          "title": "Uses",
          "type": "array"
        },
        "default": {
          "type": "boolean",
          "default": false,
          "title": "Default"
        }
      },
      "required": [
        "kind"
      ],
      "title": "AddressRow",
      "type": "object"
    },
    "DictionaryEntry": {
      "description": "A word and its meanings (\"wind\", \"breath\"); a word made only to be\na name may have none. An older file's single `meaning` is read as the\nfirst meaning and never written back.",
      "properties": {
        "word": {
          "title": "Word",
          "type": "string"
        },
        "meanings": {
          "items": {
            "type": "string"
          },
          "title": "Meanings",
          "type": "array"
        },
        "meaning": {
          "default": "",
          "title": "Meaning",
          "type": "string"
        },
        "part": {
          "default": "",
          "title": "Part",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "word"
      ],
      "title": "DictionaryEntry",
      "type": "object"
    },
    "Ending": {
      "description": "A meaningful ending (\"-nya\", land of). No `changes` means the plain\nending added.",
      "properties": {
        "ending": {
          "title": "Ending",
          "type": "string"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        },
        "example": {
          "default": "",
          "title": "Example",
          "type": "string"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/FormChange"
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "ending",
        "meaning"
      ],
      "title": "Ending",
      "type": "object"
    },
    "FormChange": {
      "description": "One way a word changes for a form or an ending (languages 4b-1):\nan ending added (`text`, after `drop` letters are taken off), a word\nput before or after it, or its first part doubled; only `when` its\ncondition holds (`name_grammar.parse_condition`).",
      "properties": {
        "when": {
          "default": "",
          "title": "When",
          "type": "string"
        },
        "kind": {
          "default": "ending",
          "enum": [
            "ending",
            "swap",
            "word_before",
            "word_after",
            "double"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "drop": {
          "default": "",
          "title": "Drop",
          "type": "string"
        }
      },
      "title": "FormChange",
      "type": "object"
    },
    "GeneratorDef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "use": {
          "title": "Use",
          "type": "string"
        },
        "patterns": {
          "items": {
            "type": "string"
          },
          "title": "Patterns",
          "type": "array"
        },
        "shapes": {
          "items": {
            "$ref": "#/$defs/NameShape"
          },
          "title": "Shapes",
          "type": "array"
        },
        "reject": {
          "items": {
            "type": "string"
          },
          "title": "Reject",
          "type": "array"
        },
        "for_person": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "For Person",
          "type": "object"
        },
        "capitalize": {
          "default": true,
          "title": "Capitalize",
          "type": "boolean"
        },
        "min_length": {
          "default": 2,
          "title": "Min Length",
          "type": "integer"
        },
        "max_length": {
          "default": 24,
          "title": "Max Length",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "use"
      ],
      "title": "GeneratorDef",
      "type": "object"
    },
    "GrammarExample": {
      "description": "A worked example: the original, word by word, and its translation.",
      "properties": {
        "original": {
          "title": "Original",
          "type": "string"
        },
        "breakdown": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Breakdown",
          "type": "array"
        },
        "translation": {
          "default": "",
          "title": "Translation",
          "type": "string"
        }
      },
      "required": [
        "original"
      ],
      "title": "GrammarExample",
      "type": "object"
    },
    "GrammarSection": {
      "description": "One topic of a language's grammar: plain text, tables, examples.",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "topic": {
          "default": "other",
          "title": "Topic",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/GrammarTable"
          },
          "title": "Tables",
          "type": "array"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/GrammarExample"
          },
          "title": "Examples",
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "title": "GrammarSection",
      "type": "object"
    },
    "GrammarTable": {
      "description": "A table in a grammar section: a conjugation, noun endings, the\npronouns. Rows are kept as written, even when ragged.",
      "properties": {
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "title": "GrammarTable",
      "type": "object"
    },
    "KeptTitle": {
      "description": "A title the language keeps in its own word (a Tsar), with what it\nmeans in English; every other title is written in English.",
      "properties": {
        "word": {
          "title": "Word",
          "type": "string"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        }
      },
      "required": [
        "word",
        "meaning"
      ],
      "title": "KeptTitle",
      "type": "object"
    },
    "Language": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "level": {
          "enum": [
            "description",
            "naming",
            "full"
          ],
          "title": "Level",
          "type": "string"
        },
        "writable": {
          "default": true,
          "title": "Writable",
          "type": "boolean"
        },
        "sound": {
          "default": "",
          "title": "Sound",
          "type": "string"
        },
        "categories": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Categories",
          "type": "object"
        },
        "syllable_notes": {
          "items": {
            "type": "string"
          },
          "title": "Syllable Notes",
          "type": "array"
        },
        "generators": {
          "items": {
            "$ref": "#/$defs/GeneratorDef"
          },
          "title": "Generators",
          "type": "array"
        },
        "grammar": {
          "items": {
            "$ref": "#/$defs/GrammarSection"
          },
          "title": "Grammar",
          "type": "array"
        },
        "dictionary": {
          "items": {
            "$ref": "#/$defs/DictionaryEntry"
          },
          "title": "Dictionary",
          "type": "array"
        },
        "phrases": {
          "items": {
            "$ref": "#/$defs/Phrase"
          },
          "title": "Phrases",
          "type": "array"
        },
        "flavour": {
          "default": "",
          "title": "Flavour",
          "type": "string"
        },
        "similar": {
          "items": {
            "$ref": "#/$defs/SimilarLink"
          },
          "title": "Similar",
          "type": "array"
        },
        "name_grammar": {
          "anyOf": [
            {
              "$ref": "#/$defs/NameGrammar"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "people_names": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeopleNames"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "level"
      ],
      "title": "Language",
      "type": "object"
    },
    "NameGrammar": {
      "description": "A language's grammar for names (languages 4b-1): word order, the\nforms \"the\" and \"more than one\", and its meaningful endings. The name\nengine (`name_grammar`) applies it; the model never does.",
      "properties": {
        "describing": {
          "default": "before",
          "enum": [
            "before",
            "after"
          ],
          "title": "Describing",
          "type": "string"
        },
        "of": {
          "anyOf": [
            {
              "$ref": "#/$defs/OfRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "joining": {
          "default": "describing_first",
          "enum": [
            "describing_first",
            "main_first"
          ],
          "title": "Joining",
          "type": "string"
        },
        "clip_first": {
          "default": false,
          "title": "Clip First",
          "type": "boolean"
        },
        "the": {
          "items": {
            "$ref": "#/$defs/FormChange"
          },
          "title": "The",
          "type": "array"
        },
        "more_than_one": {
          "items": {
            "$ref": "#/$defs/FormChange"
          },
          "title": "More Than One",
          "type": "array"
        },
        "endings": {
          "items": {
            "$ref": "#/$defs/Ending"
          },
          "title": "Endings",
          "type": "array"
        }
      },
      "title": "NameGrammar",
      "type": "object"
    },
    "NamePart": {
      "description": "One part of a composed name rule: another rule, a fixed word, a\nmeaning part (words of the language built from a meaning), a part\ntaken from a connection (\"connection\": the father's house), or one of\nthe person's own parts (\"own\": a pet name from the given name).",
      "properties": {
        "kind": {
          "enum": [
            "rule",
            "word",
            "meaning",
            "connection",
            "own"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rule": {
          "default": "",
          "title": "Rule",
          "type": "string"
        },
        "word": {
          "default": "",
          "title": "Word",
          "type": "string"
        },
        "slot": {
          "default": "noun",
          "enum": [
            "noun",
            "describing_noun"
          ],
          "title": "Slot",
          "type": "string"
        },
        "forms": {
          "items": {
            "enum": [
              "the",
              "more_than_one"
            ],
            "type": "string"
          },
          "title": "Forms",
          "type": "array"
        },
        "of": {
          "default": false,
          "title": "Of",
          "type": "boolean"
        },
        "joined": {
          "default": false,
          "title": "Joined",
          "type": "boolean"
        },
        "ending": {
          "default": "",
          "title": "Ending",
          "type": "string"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "take": {
          "default": "",
          "title": "Take",
          "type": "string"
        },
        "person_forms": {
          "items": {
            "$ref": "#/$defs/PersonForm"
          },
          "title": "Person Forms",
          "type": "array"
        },
        "english": {
          "default": "",
          "title": "English",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NamePart",
      "type": "object"
    },
    "NameShape": {
      "description": "One way a composed rule's name goes, its parts in order; shapes are\npicked by `weight`, as patterns are.",
      "properties": {
        "parts": {
          "items": {
            "$ref": "#/$defs/NamePart"
          },
          "title": "Parts",
          "type": "array"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "parts"
      ],
      "title": "NameShape",
      "type": "object"
    },
    "OfRule": {
      "description": "How \"of X\" is said: a word (on `word_side` of X) or an ending on X;\nthe of-phrase goes `place`d before or after the thing it belongs to;\nwith `the`, X takes \"the\".",
      "properties": {
        "how": {
          "default": "word",
          "enum": [
            "word",
            "ending"
          ],
          "title": "How",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "word_side": {
          "default": "before",
          "enum": [
            "before",
            "after"
          ],
          "title": "Word Side",
          "type": "string"
        },
        "place": {
          "default": "after",
          "enum": [
            "before",
            "after"
          ],
          "title": "Place",
          "type": "string"
        },
        "the": {
          "default": false,
          "title": "The",
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "title": "OfRule",
      "type": "object"
    },
    "PeopleNames": {
      "description": "A language's people's names (languages 4b-2): the choices a\nperson's name depends on (the first of each the default), the titles\nit keeps, and its forms of address.",
      "properties": {
        "choices": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Choices",
          "type": "object"
        },
        "kept_titles": {
          "items": {
            "$ref": "#/$defs/KeptTitle"
          },
          "title": "Kept Titles",
          "type": "array"
        },
        "address": {
          "items": {
            "$ref": "#/$defs/AddressRow"
          },
          "title": "Address",
          "type": "array"
        }
      },
      "title": "PeopleNames",
      "type": "object"
    },
    "PersonForm": {
      "description": "A part's form for who the person is (languages 4b-2): its changes\napply when every `when` choice matches (\"sex\": \"woman\").",
      "properties": {
        "when": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "When",
          "type": "object"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/FormChange"
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "title": "PersonForm",
      "type": "object"
    },
    "Phrase": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "original": {
          "title": "Original",
          "type": "string"
        },
        "translation": {
          "title": "Translation",
          "type": "string"
        },
        "breakdown": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Breakdown",
          "type": "array"
        },
        "usage": {
          "default": "",
          "title": "Usage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "original",
        "translation"
      ],
      "title": "Phrase",
      "type": "object"
    },
    "SimilarLink": {
      "description": "Another language this one is close to, by name (in a file; an entry\nstores the other language's id).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "degree": {
          "enum": [
            "close",
            "distant",
            "one-way"
          ],
          "title": "Degree",
          "type": "string"
        }
      },
      "required": [
        "name",
        "degree"
      ],
      "title": "SimilarLink",
      "type": "object"
    }
  },
  "description": "A language as a file: what the language-design skill writes and the\napp imports. `parent` names the language it descends from.",
  "properties": {
    "format": {
      "const": "fantasymate.language",
      "default": "fantasymate.language",
      "title": "Format",
      "type": "string"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    }
  },
  "required": [
    "language"
  ],
  "title": "LanguageFile",
  "type": "object"
}
