        "S": "sh*3 z*3 zh*2 s",
        "L": "l*3 m*2 n*2 y",
        "V": "a*4 o*3 i*2 e",
        "W": "oa ia aa ei"
      },
      "syllable_notes": [
        "Words end in a vowel or in -sh, never in another consonant",
        "No hard stops (k, t, d, g, p, b) in native words",
        "Stress on the second-to-last syllable; questions are sung upward with no particle"
      ],
